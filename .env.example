# ---------- GENERAL ----------
NODE_ENV=development
PORT=3000

# ---------- NEON DB (Serverless PostgreSQL) ----------
# Get this from your Neon dashboard -> Connection Details
# Format: postgresql://username:password@ep-xxxxx.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@ep-xxxxx.aws.neon.tech/neondb?sslmode=require

# ---------- UPSTASH REDIS (Serverless Redis) ----------
# Get this from your Upstash dashboard -> Redis Connect -> .env example
# Format: rediss://:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
REDIS_URL=rediss://:YOUR_UPSTASH_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# ---------- JWT (Shared with Dev A) ----------
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_random_32_byte_hex_string